# Neon PostgreSQL — get from neon.tech dashboard
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="verander-dit-naar-een-lange-willekeurige-string"

# Tikkie
TIKKIE_LINK="https://tikkie.me/pay/jouw-tikkie-link"

# Vercel Blob — automatisch ingesteld door Vercel na koppelen storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Admin seed wachtwoord (optioneel, gebruikt door start.sh)
ADMIN_PASSWORD="admin123"
